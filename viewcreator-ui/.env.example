# This package uses the root .env.example as its source of truth.
# See /.env.example for all environment variables used by this package.
#
# Copy /.env.example to /.env.local and fill in your values.
# (Next.js loads .env.local automatically.)
#
# Key vars for the UI package:
# - NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY  (ClerkProvider)
# - NEXT_PUBLIC_API_URL                (API base URL)
# - CLERK_SECRET_KEY                   (API route auth)
# - DODO_PAYMENTS_*                    (checkout/webhook routes)
