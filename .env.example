# ═══════════════════════════════════════════════════════════
# ViewCreator — Environment Variables
# ═══════════════════════════════════════════════════════════
# Single source of truth. Copy this file to `.env` and fill in
# your values. Never commit the actual `.env` file.
#
# Required = must be set for the app to start
# Optional = has a sensible default or is only needed for specific features
# ═══════════════════════════════════════════════════════════

# ─── Server ──────────────────────────────────────────────────────
# Express API server port
# Used by: viewcreator-api/src/index.ts
# Required: No (default: 3001)
# PORT=3001

# Node environment
# Used by: viewcreator-database/src/db.ts (query logging)
# Required: No (default: production)
# NODE_ENV=development

# ─── Database (PostgreSQL) ────────────────────────────────────────
# Full PostgreSQL connection string. For Supabase, use the pooler
# URL (port 6543) for the API server, direct URL (port 5432) for migrations.
# Used by: viewcreator-database/src/db.ts
# Required: YES
# DATABASE_URL=postgresql://user:password@host:5432/db

# Force SSL for database connections. Set to "true" for cloud Postgres
# (Supabase, RDS, etc.). Set to "false" or omit for local dev.
# Used by: viewcreator-database/src/db.ts
# Required: No (default: false)
# DB_SSL=true

# Max connections in the pg.Pool. With Supabase PgBouncer (port 6543),
# you can safely set this to 20-25. For direct connections, keep lower.
# Used by: viewcreator-database/src/db.ts
# Required: No (default: 10)
# DB_MAX_CONNECTIONS=20

# Enable verbose SQL query logging to console
# Used by: viewcreator-database/src/db.ts
# Required: No
# DEBUG_DB=true

# ─── AI / Gemini ──────────────────────────────────────────────────
# Google Gemini API key for image generation, analysis, and editing.
# Get one at https://aistudio.google.com/apikey
# Used by: viewcreator-api/src/routes/generations.ts, analyze.ts
# Required: YES
# GEMINI_NANO_BANANA_API_KEY=your_gemini_api_key_here

# ─── Authentication (Clerk) ──────────────────────────────────────
# Clerk Secret Key — for backend API auth verification.
# Find in Clerk Dashboard → API Keys.
# Used by: viewcreator-api (Express middleware), viewcreator-ui (API routes)
# Required: YES
# CLERK_SECRET_KEY=sk_test_...

# Clerk Publishable Key — for frontend ClerkProvider.
# Auto-discovered by Clerk SDK via NEXT_PUBLIC_ prefix convention.
# Used by: viewcreator-ui/src/app/layout.tsx (ClerkProvider)
# Required: YES (for frontend)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# ─── Storage (AWS S3) ────────────────────────────────────────────
# AWS region for S3 bucket
# Used by: viewcreator-api/src/services/s3-service.ts
# Required: No (default: us-east-1)
# AWS_REGION=us-east-1

# AWS IAM credentials with S3 write access
# Used by: viewcreator-api/src/services/s3-service.ts
# Required: YES
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# S3 bucket name for storing generated images/videos and templates
# Used by: viewcreator-api/src/services/s3-service.ts
# Required: YES
# AWS_S3_BUCKET=your_s3_bucket_name

# ─── Payments (Dodo Payments) ────────────────────────────────────
# Dodo Payments API key. Get from app.dodopayments.com → Developer → API Keys.
# Used by: viewcreator-api/src/routes/payments.ts, viewcreator-ui Dodo routes
# Required: YES
# DODO_PAYMENTS_API_KEY=dodo_test_...

# Dodo webhook signing key for Svix signature verification.
# Get from Dodo Dashboard → Webhooks → Signing Key.
# Used by: viewcreator-ui/src/lib/webhook-verifier.ts, viewcreator-api admin routes
# Required: YES (if webhooks are configured)
# DODO_PAYMENTS_WEBHOOK_KEY=whsec_test_...

# Dodo environment: "test_mode" or "live_mode"
# Used by: viewcreator-api + viewcreator-ui Dodo routes
# Required: YES
# DODO_PAYMENTS_ENVIRONMENT=test_mode

# URL where users are redirected after a successful Dodo checkout.
# Used by: viewcreator-api/src/routes/payments.ts
# Required: No (default: http://localhost:3000/generate)
# DODO_PAYMENTS_RETURN_URL=http://localhost:3000/generate

# (Optional) Dodo product ID for static/short checkout
# Used by: viewcreator-ui pricing page (forward-looking, not yet consumed in code)
# DODO_PRODUCT_ID_FREEMIUM=pdt_xxxxxxxxxxxxxxxxxxxxxx

# (Optional) Dodo shortlink slug for pricing page CTA redirect
# DODO_SHORTLINK_SLUG_FREEMIUM=viewcreator-free

# (Optional) Usage metering event name for backend API call tracking
# DODO_METER_EVENT_NAME=api_request

# ─── Admin ────────────────────────────────────────────────────────
# API key for admin-only endpoints (payment status, manual credit grants, etc.)
# ⚠️ CHANGE THIS FROM DEFAULT FOR PRODUCTION — use a strong random value.
# Used by: viewcreator-api/src/routes/payments.ts, admin.ts
# Required: YES (for admin endpoints)
# ADMIN_API_KEY=dev-admin-key

# ─── Frontend ────────────────────────────────────────────────────
# Base URL of the Express API server. Used by the frontend API client.
# In production, this should be the deployed API URL.
# Used by: viewcreator-ui/src/services/base/api-client.ts
# Required: No (default: http://localhost:3001)
# NEXT_PUBLIC_API_URL=http://localhost:3001

# Alternative API base URL (fallback if NEXT_PUBLIC_API_URL is empty).
# Used by: viewcreator-ui/src/services/base/index.ts
# Required: No
# NEXT_PUBLIC_API_BASE_URL=
